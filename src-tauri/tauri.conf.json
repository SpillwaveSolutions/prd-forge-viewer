{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PRD Forge Viewer",
  "version": "0.4.0",
  "identifier": "com.spillwave.prd-forge-viewer",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "PRD Forge Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
